# Copy to .env and fill in your own keys. NEVER commit .env or any real key.
# All values are placeholders.

# Birdeye: new listings, 15m OHLCV/history price, token trades.
# Without it, scanner falls back to GeckoTerminal and momentum to DexScreener.
BIRDEYE_API_KEY=your-birdeye-api-key

# Helius: Solana RPC for on-chain authority/supply checks and trade sending.
# Without it, the public mainnet RPC is used.
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your-helius-api-key

# Flux: RPC endpoint. Its ?key= value doubles as the RugCheck API key when
# no dedicated RUGCHECK_API_KEY is set.
FLUX_RPC_URL=https://your-flux-rpc.example/?key=your-flux-key

# RugCheck: dedicated API key. Takes precedence over the Flux key.
RUGCHECK_API_KEY=your-rugcheck-api-key

# Optional: alternate Solana RPC override (HELIUS_RPC_URL wins over this).
SOLANA_RPC=https://api.mainnet-beta.solana.com

# Optional: SOL price in USD used to convert a SOL amount into the USD size
# checked against the $100 per-trade limit. Default 150.00 when unset.
SOL_USD_PRICE=150.00
